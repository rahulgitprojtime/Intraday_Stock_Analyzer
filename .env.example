# Copy this file to .env and fill in real values. NEVER commit .env.
# .env is already listed in .gitignore.

# --- Groww auth: choose ONE flow via GROWW_AUTH_MODE ---
# "api_key" (daily-expiring token) or "totp" (no expiry)
GROWW_AUTH_MODE=api_key

# Used when GROWW_AUTH_MODE=api_key
GROWW_API_KEY=your_api_key_here
GROWW_API_SECRET=your_api_secret_here

# Used when GROWW_AUTH_MODE=totp
GROWW_TOTP_TOKEN=your_totp_token_here
GROWW_TOTP_SECRET=your_totp_secret_here

# --- App mode (see config/settings.yaml for the authoritative default) ---
# DATA_ONLY | SIGNAL_ONLY | PAPER_TRADING | LIVE_TRADING
APP_MODE=DATA_ONLY
# Must be explicitly "true" (in addition to APP_MODE=LIVE_TRADING) to allow
# any real order to be placed. Belt-and-suspenders per DECISIONS.md #5.
LIVE_TRADING_CONFIRMED=false

# --- Storage paths (override defaults in config/settings.yaml if needed) ---
DATA_DIR=./data

# --- Logging ---
LOG_LEVEL=INFO
